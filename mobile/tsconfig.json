{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "allowJs": true,
    "paths": {
      "@/lib/supabase": ["./src/lib/supabase.ts"],
      "@/lib/presenceThrottle": ["../js/space/lib/presenceThrottle.js"],
      "@/features/voice/webrtc/*": ["../js/space/voice/webrtc/*"]
    }
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
